    "about.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tool helps you manage your Yandex Cloud services from one place.\nYou can start or stop virtual machines, view storage buckets or serverless functions all from one place.\nIt also supports automatic VM start/stop based on macOS conditions, like when your Mac goes to sleep or wakes up."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл құрал Yandex Cloud қызметтерін бір жерден басқаруға көмектеседі.\nВиртуалды машиналарды іске қосып немесе тоқтатып, сақтау бакеттерін және серверсіз функцияларды бір жерден көре аласыз.\nСондай-ақ Mac ұйқы режиміне өткенде немесе оянғанда macOS жағдайларына негізделген ВМ автоматты іске қосу/тоқтатуды қолдайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот инструмент помогает управлять сервисами Yandex Cloud из одного места.\nВы можете запускать и останавливать виртуальные машины, просматривать бакеты хранилища и serverless-функции из одного места.\nТакже поддерживается автоматический запуск и остановка ВМ по событиям macOS, например при переходе Mac в сон или пробуждении."
          }
        }
      }
    },
